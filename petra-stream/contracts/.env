# petra-stream/contracts/.env
# --------------------------
# Somnia (Ankr) RPC endpoints you provided
SOMNIA_TEST_HTTP="https://rpc.ankr.com/somnia_testnet/c1ce531dd0fbe198e21479555f96b25c9b95b8eca147d69c6bb70bddf9e0a7ea"
SOMNIA_MAIN_HTTP="https://rpc.ankr.com/somnia_mainnet/c1ce531dd0fbe198e21479555f96b25c9b95b8eca147d69c6bb70bddf9e0a7ea"

# WebSocket (WSS) — Ankr WSS may require a premium plan; leave blank if you don't have one
SOMNIA_WS=""

# Use LOCALHOST_URL for local hardhat / ganache node
LOCALHOST_URL="http://127.0.0.1:8545"

# Which network to default to for scripts (hardhat/localhost/somnia_testnet/somnia_mainnet)
DEFAULT_NETWORK="somnia_testnet"

# Deployer private key (TESTING ONLY). Do NOT commit this. Use a testnet-funded account.
# Example: DEPLOYER_PRIVATE_KEY="0xabc123..."
DEPLOYER_PRIVATE_KEY="2e58a3ce7c72f1a0a8479850a1c24fce6c9c1b0489d2497ac0800cc4c8a093f3"

# Explorer API key (optional) — used if/when verifying contracts on an explorer
ETHERSCAN_API_KEY=""

# After you deploy locally or to testnet, set these (used by backend/indexer)
REGISTRY_ADDRESS="0xD2575342FB825E5AfEf361990adA3B63bF241326"
VAULT_ADDRESS="0x624FF968389f4040Ff84946768DaDB55C8F4f062"

# Optional: toggles
# If you want your deploy scripts to prefer the test RPC over localhost, set:
USE_HTTP_FOR_DEPLOY=true
