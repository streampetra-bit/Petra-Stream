generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stream {
  id        String   @id @default(uuid())
  streamId  String   @unique
  title     String?
  streamer  String
  status    String   @default("offline")
  createdAt DateTime @default(now())
}

model Tip {
  id        String   @id @default(uuid())
  txHash    String   @unique
  from      String
  to        String
  streamId  String
  token     String
  amount    BigInt
  memo      String?
  createdAt DateTime @default(now())
}

model Balance {
  id        String   @id @default(uuid())
  address   String
  token     String
  amount    BigInt  @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  address      String?  @unique
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  displayName  String?
  bio          String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthNonce {
  address   String   @id
  nonce     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
