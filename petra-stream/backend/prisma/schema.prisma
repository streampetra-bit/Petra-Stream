generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stream {
  id        String   @id @default(uuid())
  streamId  String   @unique
  title     String?
  streamer  String
  status    String   @default("offline")
  createdAt DateTime @default(now())
}

model Tip {
  id        String   @id @default(uuid())
  txHash    String   @unique
  from      String
  to        String
  streamId  String
  token     String
  amount    BigInt
  memo      String?
  createdAt DateTime @default(now())
}

model Balance {
  id        String   @id @default(uuid())
  address   String
  token     String
  amount    BigInt  @default(0)
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  address      String?  @unique
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  displayName  String?
  bio          String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthNonce {
  address   String   @id
  nonce     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClipNft {
  id             String   @id @default(uuid())
  tokenId        String?
  contract       String
  creatorAddress String
  creatorName    String?
  title          String
  tokenUri       String
  coverUrl       String?
  mediaUrl       String?
  txHash         String   @unique
  createdAt      DateTime @default(now())
}

model ClipListing {
  id          String   @id @default(uuid())
  tokenId     String
  marketplace String
  nftContract String?
  seller      String
  buyer       String?
  price       BigInt
  status      String   @default("listed")
  txHash      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([marketplace, tokenId], name: "marketplace_tokenId")
}
