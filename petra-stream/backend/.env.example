# DB
DATABASE_URL="postgresql://postgres:password@localhost:5432/petra?schema=public"

# Optional Mongo/Atlas fallback (used if Prisma/Postgres is not reachable)
MONGO_URL="mongodb+srv://user:pass@cluster.example.mongodb.net/petra"

# Redis
REDIS_URL=redis://localhost:6379

# Somnia RPC (HTTP and WS) - replace with your Ankr endpoints
SOMNIA_HTTP="https://rpc.ankr.com/somnia_testnet/your-key"
SOMNIA_WS=""
SOMNIA_TEST_HTTP="https://rpc.ankr.com/somnia_testnet/your-key"
SOMNIA_TEST_WS=""

# Media ingest + playback
MEDIA_RTMP_URL="rtmp://165.227.224.72/live"
MEDIA_HLS_BASE_URL="http://165.227.224.72:8888/live"
MEDIA_AUTH_TOKEN=""

# Cloudflare Stream (Live Inputs)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_PREFER_LOW_LATENCY="true"
# Optional query string appended to HLS manifests (example: protocol=llhls)
CLOUDFLARE_HLS_QUERY="protocol=llhls"
CLOUDFLARE_WEBHOOK_SECRET=""
# Reject webhook payloads that are too old (seconds)
CLOUDFLARE_WEBHOOK_TOLERANCE_SEC="300"
# Enable Cloudflare polling instead of webhooks
CLOUDFLARE_ENABLE_POLLING="false"
# Poll interval in seconds (min 6s)
CLOUDFLARE_POLL_INTERVAL_SEC="20"

# Deployed contract addresses (set after deploy)
REGISTRY_ADDRESS=""
VAULT_ADDRESS=""
CLIP_NFT_ADDRESS=""
CLIP_MARKETPLACE_ADDRESS=""

# Admin key (use with caution; for dev only)
ADMIN_PRIVATE_KEY=""
STREAMER_API_KEY=""
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# App
PORT=4000
DEFAULT_STREAMER="demo-streamer"
